@startuml

title __SRC's Class Diagram__\n


    class App {
        {static} + main()
    }

    class Game {
        + update()
    }

    class GameConsole {
        + clearScreen()
        + draw()
    }

    class GameObjects {
        + update()
    }

    class InputSystem {
        + getInput()
    }

  

  Game o-- InputSystem : input
  Game o-- GameObjects : objects
  Game o-- GameConsole : screen

App --> Game: uses

right footer


