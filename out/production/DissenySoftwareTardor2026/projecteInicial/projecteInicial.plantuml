@startuml

title __PROJECTEINICIAL's Class Diagram__\n

  namespace projecteInicial {
    class projecteInicial.DecoyDuck {
        + display()
        + fly()
        + quack()
    }
  }
  

  namespace projecteInicial {
    abstract class projecteInicial.Duck {
        + Duck()
        + swim()
        {abstract} ~ display()
        {abstract} ~ fly()
        {abstract} ~ quack()
    }
  }
  

  namespace projecteInicial {
    class projecteInicial.MallardDuck {
        + display()
        + fly()
        + quack()
    }
  }
  

  namespace projecteInicial {
    class projecteInicial.MiniDuckSimulator {
        {static} + main()
    }
  }
  

  namespace projecteInicial {
    class projecteInicial.ModelDuck {
        + display()
        + fly()
        + quack()
    }
  }
  

  namespace projecteInicial {
    class projecteInicial.RedHeadDuck {
        + display()
        + fly()
        + quack()
    }
  }
  

  namespace projecteInicial {
    class projecteInicial.RubberDuck {
        + display()
        + fly()
        + quack()
    }
  }
  

  projecteInicial.DecoyDuck -up-|> projecteInicial.Duck
  projecteInicial.MallardDuck -up-|> projecteInicial.Duck
  projecteInicial.ModelDuck -up-|> projecteInicial.Duck
  projecteInicial.RedHeadDuck -up-|> projecteInicial.Duck
  projecteInicial.RubberDuck -up-|> projecteInicial.Duck
